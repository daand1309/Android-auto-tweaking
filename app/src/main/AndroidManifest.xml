<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Built-in updater: INTERNET is used ONLY to check/download releases from this app's own
         GitHub repo (api.github.com / github.com). REQUEST_INSTALL_PACKAGES lets it hand the
         verified update to Android, which always asks you to confirm. POST_NOTIFICATIONS is for
         the optional "update available" notification. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Optional: only used (while the app is open) to set the weather location for the greeting.
         Approximate location only; never tracked in the background. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Optional "Where's my car": save the parked spot when Android Auto disconnects. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Opens Drive Mode on connect via a full-screen-intent notification (no overlay permission). -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- Deliberately NOT requested, to keep phone security (Play Protect / Samsung) happy:
         SYSTEM_ALERT_WINDOW (overlay + notification access is a malware pattern),
         REQUEST_IGNORE_BATTERY_OPTIMIZATIONS (policy-flagged). -->

    <queries>
        <!-- Needed to find patched YouTube Music builds (e.g. Morphe) whose package name we don't know in advance. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Needed to find the phone's text-to-speech voice for the welcome greeting. -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <package android:name="com.google.android.apps.youtube.music" />
        <package android:name="app.revanced.android.gms" />
        <package android:name="app.morphe.android.gms" />
        <package android:name="com.mgoogle.android.gms" />
        <package android:name="com.google.android.projection.gearhead" />
        <!-- Tracker apps we can open from "Where's my car". -->
        <package android:name="com.samsung.android.oneconnect" />
        <package android:name="com.samsung.android.fmm" />
        <package android:name="com.google.android.apps.adm" />
    </queries>

    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:name=".App"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault.DayNight">

        <!-- Tells Android Auto what this app shows on the car (car screen + pop-ups), see the xml. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <!-- Required: without it Android Auto won't list the car app in its launcher. -->
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="1" />

        <!-- The screen shown on the car display (Android Auto). Runs in Android Auto's
             developer mode ("Unknown sources"); it uses only safety-approved templates. -->
        <service
            android:name=".car.DriveCarAppService"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.POI" />
            </intent-filter>
        </service>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".DriveModeActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:label="Drive mode"
            android:screenOrientation="fullUser"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />

        <activity
            android:name=".LogActivity"
            android:exported="false"
            android:label="Drive logs" />

        <!-- Kept alive by Android once "Notification access" is granted. Gives us
             access to YouTube Music's media session and a persistent background process. -->
        <service
            android:name=".DriveMonitorService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".AutoResumeTileService"
            android:exported="true"
            android:icon="@drawable/ic_stat_note"
            android:label="Auto-resume"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Receives the result of installing an update (only Android can send it). -->
        <receiver
            android:name=".UpdateInstallReceiver"
            android:exported="false" />

        <!-- Green / red buttons on the "there is an update" question. Not exported. -->
        <receiver
            android:name=".UpdateAnswerReceiver"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
